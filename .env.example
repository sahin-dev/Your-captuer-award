
# MongoDB must be a replica set - Prisma interactive transactions are used
# throughout the contest, payment and finalization code and are unavailable on a
# standalone server. Atlas connection strings already satisfy this; a local server
# needs --replSet plus ?replicaSet=<name> here.
DATABASE_URL=
NODE_ENV=
PORT=
BCRYPT_SALT_ROUNDS=
JWT_SECRET=
EXPIRES_IN=

ADMIN_EMAIL=
ADMIN_PASSWORD=


# passport js facebook strategy configuration
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=


#passport js google strategy configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
# https://api.yourcaptureawards.com/api/v1/auth/google/callback

# Web redirect urls
SUCCESS_URL_WEB_USER=
SUCCESS_URL_WEB_USER_NEW=
SUCCESS_URL_WEB_ADMIN=
FAILURE_URL_WEB=

#DigitalOcean
DO_SPACE_ENDPOINT=
DO_SPACE_ORIGIN_ENDPOINT=
DO_SPACE_ACCESS_KEY=
DO_SPACE_SECRET_KEY=
DO_SPACE_BUCKET=

#Redis
REDIS_HOST=localhost
REDIS_PORT=6379

#Logging
# debug locally, info in production when unset
LOG_LEVEL=

#Telemetry (OpenTelemetry). Leave the endpoint empty to turn it off.
# Local stack: see monitoring/README.md
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=yca-api
# Sample a share of traces in production, e.g. 0.2 = 20%
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1
