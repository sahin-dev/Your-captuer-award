//Contest models

model Contest {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  description    String
  banner         String?       @default("https://images.unsplash.com/photo-1689539137236-b68e436248de?q=80&w=1171&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D")
  status         ContestStatus @default(UPCOMING)
  isMoneyContest Boolean       @default(false)
  maxPrize       Int?          @default(0)
  minPrize       Int?          @default(0)
  currency       String?
  entryFeeCoins  Int           @default(0)

  startDate          DateTime
  endDate            DateTime
  startedAt          DateTime?
  endedAt            DateTime?
  finalizedAt        DateTime?
  recurringContestId String?   @db.ObjectId
  configVersion      Int       @default(1)
  scoringVersion     Int       @default(1)

  creatorId  String  @db.ObjectId
  categoryId String? @db.ObjectId

  creator              User                         @relation(fields: [creatorId], references: [id])
  category             ContestCategory?             @relation(fields: [categoryId], references: [id])
  participants         ContestParticipant[]
  teamParticipations   TeamParticipation[]
  votes                Vote[]
  contestRules         ContestRule[]
  ruleConfigs          ContestRuleConfig[]
  contestAwards        ContestAward[]
  achievements         ContestAchievement[]
  entryFeeTransactions ContestEntryFeeTransaction[]
  teamMatch            TeamMatch[]
  teamMatchHistory     TeamMatchHistory[]
  recurringContest     RecurringContest?            @relation(fields: [recurringContestId], references: [id])
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  @@index([status, startDate])
  @@index([status, endDate])
  @@index([recurringContestId, startDate])
  @@index([categoryId, status, startDate])
  @@map("contests")
}

model RecurringContest {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  description    String
  banner         String? @default("https://images.unsplash.com/photo-1689539137236-b68e436248de?q=80&w=1171&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D")
  isMoneyContest Boolean @default(false)
  maxPrize       Int?    @default(0)
  minPrize       Int?    @default(0)
  currency       String?
  entryFeeCoins  Int     @default(0)

  startDate DateTime
  endDate   DateTime

  creatorId              String                 @db.ObjectId
  categoryId             String?                @db.ObjectId
  category               ContestCategory?       @relation(fields: [categoryId], references: [id])
  status                 RecurringContestStatus @default(ACTIVE)
  recurring              RecurringData
  lastGeneratedContestId String?                @db.ObjectId

  rules            Json
  prizes           Json?
  contestAwards    RecurringContestAward[]
  contestInstances Contest[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([status])
  @@index([categoryId, status])
  @@map("recurring_contests")
}

model ContestCategory {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  slug        String  @unique
  name        String  @unique
  description String?
  isActive    Boolean @default(true)
  order       Int     @default(0)

  contests          Contest[]
  recurringContests RecurringContest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
  @@map("contest_categories")
}

model RecurringContestOccurrence {
  id                 String                  @id @default(auto()) @map("_id") @db.ObjectId
  occurrenceKey      String                  @unique
  recurringContestId String                  @db.ObjectId
  scheduledAt        DateTime
  contestId          String?                 @db.ObjectId
  status             ContestOccurrenceStatus @default(PENDING)
  startedAt          DateTime?
  error              String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([recurringContestId, scheduledAt])
  @@map("recurring_contest_occurrences")
}

model Prize {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  category    PrizeType
  type        AwardType?
  target      AwardTarget?
  rankLimit   Int?
  title       String?
  description String?
  icon        String?
  boost       Int          @default(0)
  swap        Int          @default(0)
  key         Int          @default(0)
  coin        Int          @default(0)
  isActive    Boolean      @default(true)
  isDefault   Boolean      @default(false)
  order       Int          @default(0)

  contestAwards          ContestAward[]
  recurringContestAwards RecurringContestAward[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, target, rankLimit])
  @@index([isActive, isDefault, order])
  @@map("prizes")
}

model ContestRule {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  icon        String?
  name        String
  description String
  contestId   String  @db.ObjectId
  contest     Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contest_rules")
}

model ContestRuleConfig {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  contestId String  @db.ObjectId
  key       String
  value     Json
  enabled   Boolean @default(true)
  order     Int     @default(0)

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contestId, key])
  @@map("contest_rule_configs")
}

model ContestPhoto {
  id                 String               @id @default(auto()) @map("_id") @db.ObjectId
  title              String?
  contestId          String               @db.ObjectId
  participantId      String               @db.ObjectId
  photoId            String               @db.ObjectId
  rank               Int?                 @default(0)
  promoted           Boolean              @default(false)
  promotionExpiresAt DateTime?
  initialVotes       Int                  @default(0)
  // contest   Contest @relation(fields: [contestId],references: [id])
  participant        ContestParticipant   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  votes              Vote[]
  photo              UserPhoto            @relation(fields: [photoId], references: [id], onDelete: Cascade)
  comments           Comment[]
  achievements       ContestAchievement[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([contestId, photoId])
  @@index([contestId, participantId])
  @@index([contestId, createdAt])
  @@map("contest_photos")
}

model ContestParticipant {
  id             String                   @id @default(auto()) @map("_id") @db.ObjectId
  status         ContestParticipantStatus @default(ACTIVE)
  contestId      String                   @db.ObjectId
  userId         String                   @db.ObjectId
  memberId       String?                  @db.ObjectId
  level          YCLevel                  @default(NEW)
  rank           Int?                     @default(0)
  exposure_bonus Int                      @default(100)

  contest            Contest              @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user               User                 @relation(fields: [userId], references: [id])
  member             TeamMember?          @relation(fields: [memberId], references: [id])
  photos             ContestPhoto[]
  contestAchievement ContestAchievement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contestId, userId])
  @@map("contest_participants")
}

model ContestEntryFeeTransaction {
  id        String                    @id @default(auto()) @map("_id") @db.ObjectId
  contestId String                    @db.ObjectId
  userId    String                    @db.ObjectId
  amount    Int
  status    ContestEntryPaymentStatus @default(CHARGED)

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contestId, userId])
  @@index([userId, createdAt])
  @@map("contest_entry_fee_transactions")
}

model ContestRuleAcceptance {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  contestId   String   @db.ObjectId
  userId      String   @db.ObjectId
  key         String
  acceptedAt  DateTime @default(now())
  ruleVersion Int      @default(1)

  @@unique([contestId, userId, key])
  @@index([userId, contestId])
  @@map("contest_rule_acceptances")
}

model ContestAward {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  category    PrizeType
  type        AwardType?
  target      AwardTarget?
  rankLimit   Int?
  slotKey     String?
  title       String?
  description String?
  icon        String?
  boost       Int          @default(0)
  swap        Int          @default(0)
  key         Int          @default(0)
  coin        Int          @default(0)
  enabled     Boolean      @default(true)
  order       Int          @default(0)

  contestId String  @db.ObjectId
  prizeId   String  @db.ObjectId
  contest   Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  prize     Prize   @relation(fields: [prizeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contestId, type, target, rankLimit])
  @@index([contestId, enabled, order])
  @@map("contest_awards")
}

model RecurringContestAward {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  category    PrizeType
  type        AwardType?
  target      AwardTarget?
  rankLimit   Int?
  slotKey     String?
  title       String?
  description String?
  icon        String?
  boost       Int          @default(0)
  swap        Int          @default(0)
  key         Int          @default(0)
  coin        Int          @default(0)
  enabled     Boolean      @default(true)
  order       Int          @default(0)

  recurringContestId String           @db.ObjectId
  prizeId            String           @db.ObjectId
  recurringContest   RecurringContest @relation(fields: [recurringContestId], references: [id], onDelete: Cascade)
  prize              Prize            @relation(fields: [prizeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recurringContestId, type, target, rankLimit])
  @@index([recurringContestId, enabled, order])
  @@map("recurring_contest_awards")
}

model ContestAchievement {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  category      PrizeType
  kind          AchievementKind    @default(CONTEST_AWARD)
  type          AwardType?
  target        AwardTarget?
  rankLimit     Int?
  levelBadge    ContestLevelBadge?
  levelOrder    Int?
  photoId       String?            @db.ObjectId
  participantId String?            @db.ObjectId
  contestId     String             @db.ObjectId
  grantKey      String?

  photo   ContestPhoto? @relation(fields: [photoId], references: [id])
  contest Contest       @relation(fields: [contestId], references: [id])

  participant ContestParticipant? @relation(fields: [participantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contestId, kind])
  @@index([participantId, contestId])
  @@map("contest_achievements")
}

model ContestFinalization {
  id             String                    @id @default(auto()) @map("_id") @db.ObjectId
  contestId      String                    @unique @db.ObjectId
  status         ContestFinalizationStatus @default(PENDING)
  attemptCount   Int                       @default(0)
  scoringVersion Int                       @default(1)
  startedAt      DateTime?
  completedAt    DateTime?
  error          String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([status, updatedAt])
  @@map("contest_finalizations")
}

model ContestRankingResult {
  id             String              @id @default(auto()) @map("_id") @db.ObjectId
  resultKey      String              @unique
  contestId      String              @db.ObjectId
  scope          ContestRankingScope
  participantId  String              @db.ObjectId
  photoId        String?             @db.ObjectId
  score          Int
  rank           Int
  level          YCLevel?
  tieBreakKey    String
  scoringVersion Int                 @default(1)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([contestId, scope, rank])
  @@index([contestId, scope, score])
  @@map("contest_ranking_results")
}

model ContestAwardGrant {
  id             String             @id @default(auto()) @map("_id") @db.ObjectId
  grantKey       String             @unique
  contestId      String             @db.ObjectId
  contestAwardId String?            @db.ObjectId
  participantId  String             @db.ObjectId
  userId         String             @db.ObjectId
  photoId        String?            @db.ObjectId
  category       PrizeType
  kind           AchievementKind    @default(CONTEST_AWARD)
  type           AwardType?
  target         AwardTarget?
  rankLimit      Int?
  levelBadge     ContestLevelBadge?
  levelOrder     Int?
  rank           Int?
  keyReward      Int                @default(0)
  boostReward    Int                @default(0)
  swapReward     Int                @default(0)
  coinReward     Int                @default(0)
  status         ContestGrantStatus @default(PENDING)
  error          String?
  processedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([contestId, status])
  @@index([participantId, contestId])
  @@map("contest_award_grants")
}

model ContestAwardSelection {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  selectionKey   String   @unique
  contestId      String   @db.ObjectId
  contestAwardId String   @db.ObjectId
  slotKey        String
  photoId        String   @db.ObjectId
  participantId  String   @db.ObjectId
  selectedById   String   @db.ObjectId
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([contestId, slotKey])
  @@map("contest_award_selections")
}

model ContestRewardTransaction {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  grantId   String   @unique @db.ObjectId
  userId    String   @db.ObjectId
  key       Int      @default(0)
  boost     Int      @default(0)
  swap      Int      @default(0)
  coin      Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("contest_reward_transactions")
}

type Rules {
  name        String
  icon        String
  description String
}

type RecurringData {
  recurringType        RecurringType
  previousOccurrence   DateTime?
  nextOccurrence       DateTime
  duration             Int           @default(0)
  timezone             String?
  endsAt               DateTime?
  maxOccurrences       Int?
  generatedOccurrences Int?
}

enum PrizeType {
  TOP_PHOTO
  TOP_PHOTOGRAPHER
  AMATEUR
  TALENTED
  SUPREME
  SUPERIOR
  YC_PICK
  TOP_100
  TOP_50
  TOP_20
  TOP_10
  WINNER
  TOP_NOTCH
}

enum AwardType {
  TOP_RANK
  TOP_PHOTO
  TOP_PHOTOGRAPHER
  WINNER
  YC_PICK
}

enum AwardTarget {
  PHOTO
  PHOTOGRAPHER
}

enum AchievementKind {
  CONTEST_AWARD
  CONTEST_LEVEL
}

enum ContestLevelBadge {
  AMATEUR
  TALENTED
  SUPREME
  SUPERIOR
  TOP_NOTCH
}

enum ContestStatus {
  JOINED
  OPEN
  NEW // Just created, not started yet
  UPCOMING // Contest is upcoming, not started yet
  ACTIVE // Contest is currently active
  FINALIZING // Voting is frozen and final results are being calculated
  FINALIZATION_FAILED // Finalization can be retried safely
  COMPLETED // Contest has ended and winners are announced
  CLOSED // Contest is closed for new participants
}

enum ContestOccurrenceStatus {
  PENDING
  MATERIALIZING
  MATERIALIZED
  FAILED
}

enum ContestFinalizationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ContestRankingScope {
  PHOTO
  PHOTOGRAPHER
}

enum ContestGrantStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ContestType {
  ONETIME
  RECURRING
}

enum RecurringType {
  DAILY
  WEEKLY
  MONTHLY
}

enum RecurringContestStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum ContestEntryPaymentStatus {
  CHARGED
  REFUNDED
}

enum YCLevel {
  NEW
  AMATEUR
  TALENTED
  SUPREME
  SUPERIOR
  TOP_NOTCH
}

enum ContestParticipantStatus {
  ACTIVE
  BLOCKED
}

model Notification {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  title      String
  message    String
  type       NotificationType @default(DEFAULT)
  isSent     Boolean          @default(false)
  isRead     Boolean          @default(false)
  receiverId String
  data       Json?
  createdAt  DateTime         @default(now())
  updatedAT  DateTime         @updatedAt

  @@map("notifications")
}

enum NotificationType {
  DEFAULT
  INVITATION
  PAYMENT
  VOTE
  LIKE
  TEAM_JOIN_REQUEST
  TEAM_JOIN_APPROVED
  TEAM_JOIN_REJECTED
}

model Payment {
  id                String                @id @default(auto()) @map("_id") @db.ObjectId
  status            PaymentStatus         @default(PENDING)
  productId         String?               @db.ObjectId
  planId            String?               @db.ObjectId
  subscriptionId    String?               @db.ObjectId
  planName          SubscriptionPlanEnum?
  recurring         PlanRecurringType?
  userId            String                @db.ObjectId
  stripe_sessino_id String?
  amount            Float
  currency          String
  method            String
  type              PaymentType

  user      User     @relation("UserPayments", references: [id], fields: [userId])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

model SubscriptionPlan {
  id                String                 @id @default(auto()) @map("_id") @db.ObjectId
  planName          SubscriptionPlanEnum
  stripe_price_id   String
  stripe_product_id String
  amount            Float
  recurring         PlanRecurringType
  currency          String                 @default("USD")
  status            SubscriptionPlanStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscription_plans")
}

model Subscription {
  id                String               @id @default(auto()) @map("_id") @db.ObjectId
  plan              SubscriptionPlanEnum
  plan_id           String               @db.ObjectId
  userId            String               @db.ObjectId
  status            SubscriptionStatus   @default(PENDING)
  stripe_session_id String?
  subscription_id   String?
  startDate         DateTime?
  endDate           DateTime?
  user              User                 @relation(references: [id], fields: [userId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

enum SubscriptionPlanStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionStatus {
  PENDING
  VALID
  EXPIRED
}

enum PlanRecurringType {
  ONETIME
  MONTHLY
  YEARLY
}

enum SubscriptionPlanEnum {
  PREMIUM
  PRO
  FREE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  VALID
  EXPIRED
  FAILED
}

enum PaymentType {
  STORE
  SUBSCRIPTION
  CONTEST
}

model SitePolicy {
  id      String         @id @default(auto()) @map("_id") @db.ObjectId
  type    SitePolicyType
  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_policies")
}

enum SitePolicyType {
  TERMS
  POLICY
  ABOUT
}

model Room {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  teamId String @unique @db.ObjectId

  @@map("rooms")
}

model Chat {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  teamId      String  @db.ObjectId
  senderId    String  @db.ObjectId
  message     String
  messageType String  @default("text")
  fileUrl     String?

  team      Team     @relation(fields: [teamId], references: [id])
  sender    User     @relation(fields: [senderId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("chats")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/prismaClient"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Product {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  productType ProductType
  title       String
  quantity    Int
  amount      Float
  currency    String        @default("USD")
  icon        String?
  description String?
  image       String?
  status      ProductStatus @default(ACTIVE)

  @@index([id, productType])
  @@map("products")
}

model Price {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  product_id String @db.ObjectId
  name       String
  amount     Float
  quantity   Int
  price_id   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([id, product_id])
  @@map("prices")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum ProductType {
  KEY
  BOOST
  SWAP
  COIN
}

model Support {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  ticket_no String        @unique
  name      String
  email     String
  subject   String
  message   String
  status    SupportStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("supports")
}

enum SupportStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Team {
  id                  String              @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  level               String              @default("Beginner")
  language            String
  country             String
  description         String
  accessibility       TeamAccessibility   @default(PUBLIC)
  member_count        Int                 @default(0)
  member_slots        Int                 @default(22)
  score               Int                 @default(0)
  win                 Int                 @default(0)
  lost                Int                 @default(0)
  draw                Int                 @default(0)
  badge               String              @default("https://www.freepik.com/free-photo/businesspeople-having-good-time-meeting_861800.htm#fromView=keyword&page=1&position=6&uuid=59ca936a-5c54-464c-a5ed-b579a1cd4afe&query=Team") //Image file
  min_requirement     String?
  min_requirement_str String              @default("No minimum requirement")
  active_match_id     String?             @db.ObjectId
  leaderboard_rank    Int?
  total_matches       Int                 @default(0)
  skill_level         LevelName           @default(APPRENTICE)
  creatorId           String              @db.ObjectId
  creator             User                @relation(fields: [creatorId], references: [id])
  members             TeamMember[]
  chat                Chat[]
  participations      TeamParticipation[]
  MatchesAsTeam1      TeamMatch[]         @relation(name: "team1")
  MatchesAsTeam2      TeamMatch[]         @relation(name: "team2")
  joinRequests        TeamJoinRequest[]
  history             TeamMatchHistory[]
  opponentHistory     TeamMatchHistory[]  @relation("opponentTeam")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("teams")
}

model TeamMatch {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  contestId String  @db.ObjectId
  team1Id   String  @db.ObjectId
  team2Id   String  @db.ObjectId
  contest   Contest @relation(references: [id], fields: [contestId])
  team1     Team    @relation(name: "team1", references: [id], fields: [team1Id], onDelete: NoAction)
  team2     Team    @relation(name: "team2", references: [id], fields: [team2Id], onDelete: NoAction)

  // NEW: Scoring and Result Fields
  team1_score Int         @default(0)
  team2_score Int         @default(0)
  winner_id   String?     @db.ObjectId
  result      MatchResult @default(PENDING)

  status    MatchStatus @default(ACTIVE)
  startedAt DateTime    @default(now())
  endedAt   DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("team_mathces")
}

model TeamMember {
  id     String           @id @default(auto()) @map("_id") @db.ObjectId
  status TeamMemberStatus @default(ACTIVE)
  level  MemberLevel      @default(MEMBER)

  teamId             String               @db.ObjectId
  memberId           String               @unique @db.ObjectId
  team               Team                 @relation(fields: [teamId], references: [id])
  member             User                 @relation(fields: [memberId], references: [id], onDelete: Cascade)
  contestParticipant ContestParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_members")
}

model TeamParticipation {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  teamId    String @db.ObjectId
  contestId String @db.ObjectId

  team    Team    @relation(references: [id], fields: [teamId])
  contest Contest @relation(references: [id], fields: [contestId])

  @@unique([teamId, contestId])
  @@index([teamId])
  @@map("team_participations")
}

model TeamInvitation {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  teamId     String @db.ObjectId
  receiverId String @db.ObjectId
  senderId   String @db.ObjectId

  status    InvitationStatus @default(ACTIVE)
  expiredAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_invitations")
}

// NEW: Team Join Request Model
model TeamJoinRequest {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  teamId      String @db.ObjectId
  requesterId String @db.ObjectId

  team      Team @relation(fields: [teamId], references: [id])
  requester User @relation("sentJoinRequests", fields: [requesterId], references: [id])

  status JoinRequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_join_requests")
}

// NEW: Team Match History Model
model TeamMatchHistory {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  teamId String @db.ObjectId
  team   Team   @relation(fields: [teamId], references: [id])

  matchId          String        @db.ObjectId
  opponent_team_id String        @db.ObjectId
  team_score       Int
  opponent_score   Int
  result           HistoryResult
  match_date       DateTime
  contest_id       String?       @db.ObjectId

  opponent_team Team?    @relation("opponentTeam", fields: [opponent_team_id], references: [id])
  contest       Contest? @relation(fields: [contest_id], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([teamId, matchId])
  @@map("team_match_history")
}

enum TeamAccessibility {
  PUBLIC
  PRIVATE
}

enum InvitationStatus {
  ACTIVE
  EXPIRED
}

enum MatchStatus {
  ACTIVE
  CLOSED
}

enum TeamMemberStatus {
  ACTIVE
  REMOVED
  BLOCKED
}

enum MemberLevel {
  NEW
  EXPERT
  MASTER
  LEADER
  MEMBER
  MODERATOR
}

// NEW: Enums for Team Join Request System
enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// NEW: Enums for Team Match Result Tracking
enum MatchResult {
  PENDING
  TEAM1_WIN
  TEAM2_WIN
  DRAW
}

enum HistoryResult {
  WIN
  LOSS
  DRAW
}

// NEW: Enums for Team Skill Level Classification
enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model User {
  id                 String                @id @default(auto()) @map("_id") @db.ObjectId
  cover              String?
  avatar             String?
  socialId           String?
  socialProvider     String?
  firstName          String?
  lastName           String?
  fullName           String?
  username           String?
  phone              String?
  email              String                @unique
  dateOfBirth        DateTime?
  location           String?
  country            String?
  password           String?
  customerId         String?
  role               UserRole              @default(USER)
  accessToken        String?
  isActive           Boolean               @default(true)
  isBlocked          Boolean               @default(false)
  isDeleted          Boolean               @default(false)
  currentLevel       Int                   @default(-1)
  voting_power       Int                   @default(1)
  totalVotes         Int                   @default(0)
  purchased_plan     SubscriptionPlanEnum?
  level              UserLevel?
  otps               Otp?
  store              UserStore?
  createdTeam        Team[]
  joinedTeam         TeamMember?
  sentJoinRequests   TeamJoinRequest[]     @relation("sentJoinRequests")
  createdContests    Contest[]
  commentProvides    Comment[]             @relation("provider")
  followers          Follow[]              @relation(name: "follower")
  followings         Follow[]              @relation(name: "following")
  votes              Vote[]
  likes              Like[]
  userPhotos         UserPhoto[]
  ContestParticipant ContestParticipant[]
  chat               Chat[]
  subscriptions      Subscription[]
  payments           Payment[]             @relation("UserPayments")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model UserStore {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId
  coins  Int    @default(0)
  key    Int    @default(0)
  boost  Int    @default(0)
  swap   Int    @default(0)
  coin   Int    @default(0)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_stores")
}

model UserPhoto {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  url         String
  userId      String      @db.ObjectId
  states      PhotoStats?
  views       Int         @default(0)
  labels      String[]    @default([])
  title       String?
  description String?
  adult       Boolean     @default(false)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  contestUpload ContestPhoto[]
  likes         Like[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_photos")
}

model Like {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  providerId String? @db.ObjectId
  photoId    String  @db.ObjectId

  provider User?     @relation(fields: [providerId], references: [id], onDelete: SetNull)
  photo    UserPhoto @relation(fields: [photoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("likes")
}

model Otp {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  code       String
  expires_in DateTime
  userId     String   @unique @db.ObjectId

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpStatus OtpStatus @default(CREATED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  @@map("otps")
}

model Comment {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  text       String
  providerId String  @db.ObjectId
  photoId    String? @db.ObjectId
  parentId   String? @db.ObjectId

  provider       User          @relation(name: "provider", fields: [providerId], references: [id])
  photo          ContestPhoto? @relation(fields: [photoId], references: [id])
  parent         Comment?      @relation(name: "replies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  commentReplies Comment[]     @relation("replies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("comments")
}

model Follow {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  followerId  String @db.ObjectId
  followingId String @db.ObjectId
  follower    User   @relation(name: "follower", fields: [followerId], references: [id])
  following   User   @relation(name: "following", fields: [followingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([followerId, followingId])
  @@map("follows")
}

model Vote {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  providerId String?  @db.ObjectId
  photoId    String   @db.ObjectId
  contestId  String   @db.ObjectId
  type       VoteType
  power      Int      @default(1)
  weight     Int      @default(1)

  provider User?        @relation(fields: [providerId], references: [id], onDelete: SetNull)
  photo    ContestPhoto @relation(fields: [photoId], references: [id])
  contest  Contest      @relation(fields: [contestId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, contestId, photoId])
  @@index([contestId, photoId])
  @@index([contestId, providerId])
  @@map("votes")
}

model UserLevel {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  userId  String @unique @db.ObjectId
  levelId String @db.ObjectId

  level Level @relation(references: [id], fields: [levelId])
  user  User? @relation(references: [id], fields: [userId], onDelete: Cascade)

  @@map("user_levels")
}

model Level {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  level        Int
  levelName    LevelName
  order        Int                @default(0)
  requirements LevelRequirement[]
  userLevel    UserLevel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

