model Faq {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    question  String
    answer    String
    category  String?
    order     Int      @default(0)
    isActive  Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([isActive, order])
    @@index([category])
    @@map("faqs")
}
